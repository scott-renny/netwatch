[Unit]
Description=NET-WATCH Network Monitoring API
# Start only after the network is fully up — the API needs to reach
# Pi-hole and run arp-scan, so ordering matters
After=network-online.target
Wants=network-online.target

[Service]
# Run as root because arp-scan needs raw socket access to send ARP packets.
# If you prefer not to run as root, you can instead grant the specific
# capability with: sudo setcap cap_net_raw=eip /usr/bin/arp-scan
User=root
WorkingDirectory=/opt/netwatch/api

# The ExecStart path must be the full path to python3.
# Confirm yours with: which python3
RuntimeDirectory=netwatch
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkdir -p /run/netwatch/.gunicorn
ExecStart=/opt/netwatch/venv/bin/gunicorn --workers 1 --threads 8 --bind 127.0.0.1:8082 --timeout 120 --worker-tmp-dir /run/netwatch --access-logfile - --error-logfile - netwatch_api:app

# Restart automatically if the process crashes or is killed.
# RestartSec gives it 5 seconds before trying again so a rapid crash
# loop doesn't hammer the system.
Restart=always
RestartSec=5

# Write stdout/stderr to the systemd journal.
# View logs with: journalctl -u netwatch -f
StandardOutput=journal
StandardError=journal

# Keep environment variables clean
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/run/netwatch
Environment=NETWATCH_BIND=127.0.0.1
Environment=NETWATCH_PORT=8082
EnvironmentFile=/etc/netwatch/netwatch.env

# Limit what a compromised dashboard process can reach or modify.
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/netwatch/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
# Start at boot, in the normal multi-user runlevel
WantedBy=multi-user.target

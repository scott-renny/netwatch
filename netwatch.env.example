# Copy values into /etc/netwatch/netwatch.env (mode 600).
# Never commit real passwords or secrets.

NETWATCH_PASSWORD=replace-with-a-strong-password
NETWATCH_SECRET=replace-with-python-secrets-token-hex-32
NETWATCH_AUTH_ENABLED=true
TZ=America/Toronto
NETWATCH_BIND=127.0.0.1
NETWATCH_PORT=8082
NETWATCH_HTTPS=false
AUTO_SCAN_INTERVAL=300

# JSON must remain on one line. Add one object per VLAN interface.
SCAN_SUBNETS_JSON=[{"subnet":"192.168.1.0/24","interface":"enp2s0"},{"subnet":"10.10.10.0/24","interface":"enp2s0.10"}]

PIHOLE_ENABLED=false
PIHOLE_HOST=192.168.1.30
PIHOLE_PORT=80
PIHOLE_HTTPS=false
PIHOLE_V6_PASSWORD=

WAZUH_ENABLED=false
WAZUH_URL=https://localhost:55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=
